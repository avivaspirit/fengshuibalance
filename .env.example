# Facebook auto-sync — set-and-forget setup
#
# === REQUIRED (GitHub Secrets) ===
FB_PAGE_ID=367355370015900
FB_PAGE_ACCESS_TOKEN=...   # Permanent Page token (see below)
#
# === RECOMMENDED for token expiry monitoring ===
FB_APP_ID=...              # Meta app ID (same app used to create token)
FB_APP_SECRET=...          # Meta app secret — GitHub secret only, never commit
#
# === OPTIONAL (Vercel /api/facebook-sync trigger) ===
SYNC_SECRET=choose-a-long-random-string
CRON_SECRET=same-or-different-long-random-string
GITHUB_TOKEN=...           # fine-grained PAT with actions:write on repo
GITHUB_REPO=avivaspirit/fengshuibalance
#
# ---------------------------------------------------------------------------
# PERMANENT TOKEN (do this once — no 60-day renewal)
# ---------------------------------------------------------------------------
# 1. business.facebook.com → Business Settings → Users → System users
# 2. Add System User → Assign Fengshui Balance page + pages_read_engagement
# 3. Generate token for your Meta app → copy token (does not expire)
# 4. Save as GitHub secret FB_PAGE_ACCESS_TOKEN
#
# Alternative (shorter-lived): Graph API Explorer → Page token → extend to
# long-lived user token → exchange for Page token. Prefer System User instead.
#
# ---------------------------------------------------------------------------
# AUTOMATION (runs without you)
# ---------------------------------------------------------------------------
# • GitHub Actions: every 2 hours — imports new original posts, commits, deploys
# • Weekly token health check — fails early if token is about to expire
# • Catch-up pagination — scans until recent posts are all known (not just 25)
#
# Manual test:
#   python scripts/sync-facebook-posts.py --verify-token
#   python scripts/sync-facebook-posts.py --dry-run
#   python scripts/sync-facebook-posts.py --backfill --dry-run   # one-time gap fill
